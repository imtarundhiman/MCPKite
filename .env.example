POSTGRES_PASSWORD=replace-with-a-database-password
PGADMIN_DEFAULT_EMAIL=your-email@example.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
VITE_MCP_ENDPOINT_BASE_URL=http://localhost:8000
# Local Compose defaults use MinIO; select azure_blob to use Azurite instead.
RESOURCE_STORAGE_PROVIDER=s3
RESOURCE_S3_BUCKET=webmcp-resources
RESOURCE_S3_REGION=us-east-1
RESOURCE_S3_ENDPOINT_URL=http://s3mock:9090
AWS_ACCESS_KEY_ID=s3mock
AWS_SECRET_ACCESS_KEY=s3mock
RESOURCE_AZURE_CONNECTION_STRING=
RESOURCE_AZURE_CONTAINER=webmcp-resources
TOOL_SANDBOX_CPU_LIMIT=1
TOOL_SANDBOX_MEMORY_MIB=256
TOOL_SANDBOX_PIDS_LIMIT=32
TOOL_SANDBOX_TIMEOUT_SECONDS=10
TOOL_SANDBOX_TMPFS_MIB=32
TOOL_SANDBOX_MAX_CONCURRENT_RUNS=4
TOOL_SANDBOX_QUEUE_TIMEOUT_SECONDS=2
TOOL_SANDBOX_MAX_SOURCE_BYTES=20000
TOOL_SANDBOX_MAX_PARAMETERS=64
TOOL_SANDBOX_MAX_INPUT_BYTES=65536
TOOL_SANDBOX_MAX_OUTPUT_BYTES=262144
TOOL_SANDBOX_PROXY_MAX_CONNECTIONS=128
TOOL_SANDBOX_PROXY_IDLE_TIMEOUT_SECONDS=15
TOOL_SANDBOX_PROXY_MAX_TUNNEL_BYTES=10485760
TOOL_SANDBOX_PROXY_MAX_HEADER_BYTES=65536
